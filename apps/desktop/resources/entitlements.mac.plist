<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PK-04: hardened runtime entitlements for the notarised build. V8 needs JIT and executable memory; the native
  terminal module (node-pty) and the bundled ACP adapters are loaded from disk, so library validation is off.
  ADE is not sandboxed by the App Store (it starts the user's own agents and shells).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
